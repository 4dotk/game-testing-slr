@article{roohi_predicting_2021,
	title = {Predicting {Game} {Difficulty} and {Engagement} {Using} {AI} {Players}},
	volume = {5},
	issn = {2573-0142},
	url = {https://dl.acm.org/doi/10.1145/3474658},
	doi = {10.1145/3474658},
	abstract = {This paper presents a novel approach to automated playtesting for the prediction of human player behavior and experience. We have previously demonstrated that Deep Reinforcement Learning (DRL) game-playing agents can predict both game difficulty and player engagement, operationalized as average pass and churn rates. We improve this approach by enhancing DRL with Monte Carlo Tree Search (MCTS). We also motivate an enhanced selection strategy for predictor features, based on the observation that an AI agent's best-case performance can yield stronger correlations with human data than the agent's average performance. Both additions consistently improve the prediction accuracy, and the DRL-enhanced MCTS outperforms both DRL and vanilla MCTS in the hardest levels. We conclude that player modelling via automated playtesting can benefit from combining DRL and MCTS. Moreover, it can be worthwhile to investigate a subset of repeated best AI agent runs, if AI gameplay does not yield good predictions on average.},
	language = {en},
	number = {CHI PLAY},
	urldate = {2026-10-19},
	journal = {Proc. ACM Hum.-Comput. Interact.},
	author = {Roohi, Shaghayegh and Guckelsberger, Christian and Relas, Asko and Heiskanen, Henri and Takatalo, Jari and Hämäläinen, Perttu},
	month = oct,
	year = {2021},
	pages = {1--17},
}

